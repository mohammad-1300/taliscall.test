      - name: Verify RDP and Tailscale
        shell: powershell
        run: |
          Write-Host "===== RDP SERVICE ====="
          Get-Service TermService | Format-Table Status, Name, DisplayName

          Write-Host ""
          Write-Host "===== RDP REGISTRY ====="
          Get-ItemProperty `
            'HKLM:\System\CurrentControlSet\Control\Terminal Server' `
            -Name fDenyTSConnections

          Write-Host ""
          Write-Host "===== RDP LISTENER ====="
          Get-NetTCPConnection -LocalPort 3389 -State Listen -ErrorAction SilentlyContinue |
            Format-Table LocalAddress, LocalPort, State, OwningProcess

          Write-Host ""
          Write-Host "===== TAILSCALE STATUS ====="
          & "$env:ProgramFiles\Tailscale\tailscale.exe" status

          Write-Host ""
          Write-Host "===== TAILSCALE IP ====="
          $ip = (& "$env:ProgramFiles\Tailscale\tailscale.exe" ip -4).Trim()
          Write-Host "TAILSCALE_IP=$ip"

          Write-Host ""
          Write-Host "===== TEST LOCAL 3389 ====="
          Test-NetConnection 127.0.0.1 -Port 3389

          Write-Host ""
          Write-Host "================================"
          Write-Host "TAILSCALE IP: $ip"
          Write-Host "RDP PORT: 3389"
          Write-Host "USERNAME: rdpuser"
          Write-Host "PASSWORD: $env:RDP_PASSWORD"
          Write-Host "================================"
